# ─── CEIUM app — variables de entorno ───
# Copiar a .env (dev) y ajustar. Todos los scripts npm se ejecutan desde app/.

# Base de datos (SQLite en dev; relativo a app/). En producción: postgresql://...
DATABASE_URL="file:./dev.db"

# URL pública de la app (enlaces en correos, return/cancel URLs de PayPal)
APP_URL="http://localhost:3000"

# Admin inicial creado por el seed (admin@ceium.net / staff@ceium.net)
ADMIN_PASSWORD="ceium-admin-2026"
STAFF_PASSWORD="ceium-staff-2026"
# Secreto para firmar cookies de sesión del panel (>= 32 caracteres)
SESSION_SECRET="dev-only-change-me-dev-only-change-me-000"
# Secreto para disparar jobs por HTTP (expirar reservas, reintentar matrículas, certificados)
CRON_SECRET="dev-cron-secret"

# ─── Moodle (REST: /webservice/rest/server.php, wstoken, moodlewsrestformat=json) ───
# Dev/test: mock local (npm run mocks) → http://localhost:4010
MOODLE_URL="http://localhost:4010"
MOODLE_TOKEN="mock-moodle-token"
# Rol de estudiante para enrol_manual_enrol_users (Moodle estándar: 5)
MOODLE_STUDENT_ROLE_ID="5"
# URL que se envía al alumno en el correo de acceso a la plataforma
MOODLE_LOGIN_URL="http://localhost:4010/login/index.php"

# ─── PayPal (Orders v2 + webhooks) ───
# Sandbox real: https://api-m.sandbox.paypal.com   ·  Mock local: http://localhost:4020
PAYPAL_BASE_URL="http://localhost:4020"
PAYPAL_CLIENT_ID="mock-client-id"
PAYPAL_CLIENT_SECRET="mock-client-secret"
PAYPAL_WEBHOOK_ID="mock-webhook-id"
# Client id expuesto al navegador (botones/SDK de PayPal), normalmente = PAYPAL_CLIENT_ID
NEXT_PUBLIC_PAYPAL_CLIENT_ID="mock-client-id"

# ─── Correo (nodemailer) ───
# MAIL_TRANSPORT=outbox → solo guarda en tabla EmailOutbox + var/mail/*.eml (dev/test)
# MAIL_TRANSPORT=smtp   → envía por SMTP (y también registra en EmailOutbox)
MAIL_TRANSPORT="outbox"
MAIL_FROM="CEIUM <no-reply@ceium.net>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Copia oculta de correos transaccionales al equipo (opcional)
MAIL_BCC=""

# ─── Archivos ───
# Imágenes subidas desde el panel (servidas públicamente)
UPLOAD_DIR="public/uploads"
# Comprobantes de pago (privados) y PDFs de certificados
PRIVATE_FILES_DIR="var/files"
CERTIFICATES_DIR="var/certificates"
MAIL_DIR="var/mail"
# Transporte outbox (dev): el .eml se guarda SIN la contraseña temporal de Moodle. "true" la deja visible (solo dev).
MAIL_OUTBOX_REVEAL_SECRETS="false"

# ─── Mocks (npm run mocks) ───
MOCK_MOODLE_PORT="4010"
MOCK_PAYPAL_PORT="4020"
# A dónde envía el mock de PayPal los webhooks firmados
MOCK_PAYPAL_WEBHOOK_TARGET="http://localhost:3000/api/webhooks/paypal"
# El mock envía también CHECKOUT.ORDER.APPROVED al aprobar (suscribir ese evento en PayPal real).
MOCK_PAYPAL_APPROVAL_WEBHOOKS="true"
